-- ═══════════════════════════════════════════════════════════════
function MaxUI:_buildStatusBar()
    local bar = new("Frame", {
        Name = "StatusBar",
        Size = UDim2.new(1, 0, 0, 26),
        Position = UDim2.new(0, 0, 0, 52),
        BackgroundColor3 = Config.BG,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = self.Main,
    })

    new("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = Config.Stroke,
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0,
        Parent = bar,
    })

    local layout = new("Frame", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Parent = bar,
    })
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 14),
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = layout,
    })

    local function makeStat(icon, label, color, order)
        local wrap = new("Frame", {
            Size = UDim2.new(0, 90, 1, 0),
            BackgroundTransparency = 1,
            LayoutOrder = order,
            Parent = layout,
        })
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 4),
            VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = wrap,
        })

        new("TextLabel", {
            Size = UDim2.new(0, 14, 1, 0),
            BackgroundTransparency = 1,
            Text = icon,
            TextColor3 = color,
            TextSize = 11,
            Font = Config.FontMid,
            LayoutOrder = 1,
            Parent = wrap,
        })

        new("TextLabel", {
            Size = UDim2.new(0, 40, 1, 0),
            BackgroundTransparency = 1,
            Text = label,
            TextColor3 = Config.TextDim,
            TextSize = 10,
            Font = Config.FontMid,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 2,
            Parent = wrap,
        })

        local value = new("TextLabel", {
            Size = UDim2.new(0, 40, 1, 0),
            BackgroundTransparency = 1,
            Text = "--",
            TextColor3 = color,
            TextSize = 10,
            Font = Config.Font,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 3,
            Parent = wrap,
        })
        return value
    end

    self.StatFPS  = makeStat("⚡", "FPS:",  Config.Success, 1)
    self.StatPing = makeStat("📡", "PING:", Config.Accent3, 2)
    self.StatTime = makeStat("🕒", "TIME:", Config.Warn, 3)
    self.StatMem  = makeStat("💾", "MEM:",  Config.TextMid, 4)

    local frames, lastUpdate = 0, tick()
    self._fps = 60
    self._ping = 0
    self._mem = 0

    table.insert(self.Connections, RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local now = tick()
        if now - lastUpdate >= 0.5 then
            self._fps = math.floor(frames / (now - lastUpdate) + 0.5)
            frames = 0
            lastUpdate = now

            pcall(function()
                local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                self._ping = math.floor(ping + 0.5)
            end)

            pcall(function()
                self._mem = math.floor(Stats:GetTotalMemoryUsageMb())
            end)

            if self.StatFPS and self.StatFPS.Parent then
                self.StatFPS.Text = tostring(self._fps)
                self.StatFPS.TextColor3 = self._fps >= 45 and Config.Success
                    or self._fps >= 25 and Config.Warn
                    or Config.Danger
            end
            if self.StatPing and self.StatPing.Parent then
                self.StatPing.Text = tostring(self._ping) .. "ms"
                self.StatPing.TextColor3 = self._ping <= 80 and Config.Success
                    or self._ping <= 150 and Config.Warn
                    or Config.Danger
            end
            if self.StatTime and self.StatTime.Parent then
                self.StatTime.Text = os.date("%H:%M:%S")
            end
            if self.StatMem and self.StatMem.Parent then
                self.StatMem.Text = tostring(self._mem) .. "MB"
            end
        end
    end))
end

