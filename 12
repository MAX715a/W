    }, Container)

    -- ──────────────────────────────────────────────────────────
    --  ANIMATION HELPER
    -- ──────────────────────────────────────────────────────────
    local function anim(inst, props, duration, style, dir)
        if not AnimEnabled or not inst or not inst.Parent then
            if inst then
                for k, v in pairs(props or {}) do
                    pcall(function() inst[k] = v end)
                end
            end
            return nil
        end
        local t = TweenService:Create(
            inst,
            TweenInfo.new(
                duration or 0.25,
                style or Enum.EasingStyle.Quint,
                dir or Enum.EasingDirection.Out
            ),
            props
        )
        t:Play()
        return t
    end
    Window._anim = anim

    -- ═══════════════════════════════════════════════════════════
    --  ENTRANCE ANIMATION
    -- ═══════════════════════════════════════════════════════════
    task.spawn(function()
        MainFrame.Size = UDim2.new(0, 0, 0, 0)
        MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.BackgroundTransparency = 1
        MainStroke.Transparency = 1
        TitleLabel.TextTransparency = 1
        SubTitleLabel.TextTransparency = 1
        CloseButton.BackgroundTransparency = 1
        CloseButton.TextTransparency = 1
        CloseStroke.Transparency = 1

        task.wait(0.1)
        anim(Overlay, { BackgroundTransparency = 0.55 }, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        anim(MainFrame, {
            Size = UDim2.new(0, WIN_W, 0, WIN_H),
            Position = UDim2.new(0.5, -WIN_W / 2, 0.5, -WIN_H / 2),
            BackgroundTransparency = 0,
        }, ANIM_SPEED, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        anim(MainStroke, { Transparency = 0 }, 0.5)

        task.wait(0.15)
        anim(TitleLabel, { TextTransparency = 0 }, 0.3)
        task.wait(0.08)
        anim(SubTitleLabel, { TextTransparency = 0 }, 0.3)
        anim(CloseButton, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.25)
        anim(CloseStroke, { Transparency = 0 }, 0.25)

        task.spawn(function()
            anim(Glow, { BackgroundTransparency = 0.75 }, 0.6)
            task.wait(0.6)
            anim(Glow, { BackgroundTransparency = 0.9 }, 0.6)
        end)

        task.wait(0.35)
        anim(Overlay, { BackgroundTransparency = 1 }, 0.4)
    end)

    -- ═══════════════════════════════════════════════════════════
    --  DRAG SYSTEM
    -- ═══════════════════════════════════════════════════════════
    local IsDragging = false
    local DragStart, StartPos

    local function startDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        IsDragging = true
        DragStart = input.Position
        StartPos = MainFrame.Position
    end

    local function endDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            IsDragging = false
        end
    end

    TitleLabel.InputBegan:Connect(startDrag)
    TitleLabel.InputEnded:Connect(endDrag)
    SubTitleLabel.InputBegan:Connect(startDrag)
    SubTitleLabel.InputEnded:Connect(endDrag)

    table.insert(Window._connections, UserInputService.InputChanged:Connect(function(input)
        if not IsDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + delta.Y
        )
    end))

    table.insert(Window._connections, UserInputService.InputEnded:Connect(endDrag))

    -- ═══════════════════════════════════════════════════════════
    --  CLOSE BUTTON
    -- ═══════════════════════════════════════════════════════════
    CloseButton.MouseEnter:Connect(function()
        anim(CloseButton, { BackgroundColor3 = Color3.fromRGB(180, 50, 60) }, 0.15)
        anim(CloseStroke, { Color = Color3.fromRGB(240, 100, 110) }, 0.15)
    end)
    CloseButton.MouseLeave:Connect(function()
        anim(CloseButton, { BackgroundColor3 = Color3.fromRGB(24, 26, 34) }, 0.15)
        anim(CloseStroke, { Color = Color3.fromRGB(60, 65, 80) }, 0.15)
    end)
    CloseButton.MouseButton1Click:Connect(function()
        if Window.Destroy then Window:Destroy() end
    end)

    -- ═══════════════════════════════════════════════════════════
    --  CONTAINER SCROLLING (لما العناصر تكتر)
    -- ═══════════════════════════════════════════════════════════
    local ScrollingFrame = create("ScrollingFrame", {
        Name = "ScrollingContainer",
        Size = UDim2.new(0.92, 0, 0, 218),
        Position = UDim2.new(0.04, 0, 0, 78),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(60, 65, 80),
        ScrollBarImageTransparency = 0.3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        Active = true,
    }, MainFrame)
    Window.ScrollContainer = ScrollingFrame

    local ScrollList = create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
    }, ScrollingFrame)

    create("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 6),
    }, ScrollingFrame)

    -- نخفي الـ Container الأصلي ونستخدم ScrollingFrame
    Container.Visible = false
    Window._elementsContainer = ScrollingFrame

    -- ═══════════════════════════════════════════════════════════
    --  DESTROY
    -- ═══════════════════════════════════════════════════════════
    function Window:Destroy()
        if self._destroyed then return end
        self._destroyed = true

        local out = anim(MainFrame, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 1,
        }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)

        anim(Overlay, { BackgroundTransparency = 0.5 }, 0.3)

        local function cleanup()
            for _, c in ipairs(self._connections) do
                pcall(function() c:Disconnect() end)
            end
            pcall(function() MaxScreenGui:Destroy() end)
        end

        if out then
            out.Completed:Connect(cleanup)
        else
            cleanup()
        end
    end

    -- ═══════════════════════════════════════════════════════════
    --  ANIMATIONS TOGGLE
    -- ═══════════════════════════════════════════════════════════
    function Window:SetAnimations(enabled)
        AnimEnabled = enabled and true or false
    end

    -- ═══════════════════════════════════════════════════════════
    --  INTERNAL: helper للعناصر
    -- ═══════════════════════════════════════════════════════════
    Window._create = create
    Window._anim = anim

    -- ═══════════════════════════════════════════════════════════
