    -- AddButton, AddInput, AddGridButtons
    -- AddToggle, AddSlider, AddDropdown, AddSection, AddLabel, AddKeybind
    -- Notify, NotifySuccess, NotifyError, NotifyWarning, NotifyInfo

    -- هنعرّفهم هنا مباشرة قبل return عشان الملف يشتغل منفرد
    -- (الأجزاء 2 و3 هتكملهم لو حبيت)

    return Window
end

