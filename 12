        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(50, 52, 65),
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
        ZIndex = 0,
    }, MainFrame)
    create("UICorner", { CornerRadius = UDim.new(0, 20), Parent = Glow })

    -- ──────────────────────────────────────────────────────────
    --  HEADER
    -- ──────────────────────────────────────────────────────────
