    Window._elements = {}
    Window._tabs = {}
    Window._currentTab = nil
    Window._connections = {}
    Window._destroyed = false
    Window.Flags = {}

    -- Window dimensions (same as original)
    local WIN_W = 360
    local WIN_H = 320
    local ANIM_SPEED = 0.5
    local AnimEnabled = true

