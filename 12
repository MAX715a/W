            AutoButtonColor = false,
            TextTransparency = 1,
        }, Wrap)
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Selected })
        local SelStroke = create("UIStroke", {
            Color = Color3.fromRGB(60, 65, 80),
            Thickness = 1.2,
            Transparency = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, Selected)

        local List = create("ScrollingFrame", {
            Size = UDim2.new(1, -16, 0, math.min(#Options * 28, 140)),
            Position = UDim2.new(0, 8, 0, 46),
            BackgroundColor3 = Color3.fromRGB(20, 22, 30),
            BackgroundTransparency = 0.05,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(80, 200, 120),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 5,
        }, Wrap)
        create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = List })

        create("UIListLayout", {
            Padding = UDim.new(0, 2),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, List)
        create("UIPadding", {
            PaddingTop = UDim.new(0, 4),
            PaddingBottom = UDim.new(0, 4),
        }, List)

        task.spawn(function()
            task.wait(0.6)
            anim(Wrap, { BackgroundTransparency = 0 }, 0.3)
            anim(WrapStroke, { Transparency = 0 }, 0.3)
            anim(Label, { TextTransparency = 0 }, 0.3)
            anim(Selected, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.3)
            anim(SelStroke, { Transparency = 0 }, 0.3)
        end)

        local Buttons = {}
        for i, opt in ipairs(Options) do
            local Btn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundColor3 = opt == Default and Color3.fromRGB(30, 40, 32) or Color3.fromRGB(24, 26, 34),
                Text = tostring(opt),
                TextColor3 = opt == Default and Color3.fromRGB(120, 240, 160) or Color3.fromRGB(180, 185, 200),
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                AutoButtonColor = false,
                LayoutOrder = i,
            }, List)
            create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Btn })

            Btn.MouseButton1Click:Connect(function()
                State.Value = opt
                self.Flags[Flag] = opt
                Selected.Text = tostring(opt) .. "  ▼"
                for _, b in ipairs(Buttons) do
                    local on = b.Text == tostring(opt)
                    b.BackgroundColor3 = on and Color3.fromRGB(30, 40, 32) or Color3.fromRGB(24, 26, 34)
                    b.TextColor3 = on and Color3.fromRGB(120, 240, 160) or Color3.fromRGB(180, 185, 200)
                end
                State.Open = false
                List.Visible = false
                anim(Wrap, { Size = UDim2.new(1, 0, 0, 42) }, 0.2)
                if OnChange then task.spawn(OnChange, opt) end
            end)
            table.insert(Buttons, Btn)
        end

        Selected.MouseButton1Click:Connect(function()
            State.Open = not State.Open
            List.Visible = State.Open
            Selected.Text = tostring(State.Value) .. (State.Open and "  ▲" or "  ▼")
            local targetH = State.Open and (42 + math.min(#Options * 28, 140) + 8) or 42
            anim(Wrap, { Size = UDim2.new(1, 0, 0, targetH) }, 0.22)
        end)

        return {
            Set = function(_, v)
                State.Value = v
                Selected.Text = tostring(v) .. "  ▼"
            end,
            Get = function() return State.Value end,
        }
    end

