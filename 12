        BackgroundTransparency = 1,
        Text = tab.Icon,
        TextColor3 = Config.TextDim,
        TextSize = 14,
        Font = Config.FontMid,
        Parent = btn,
    })

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -44, 1, 0),
        Position = UDim2.new(0, 40, 0, 0),
        BackgroundTransparency = 1,
        Text = tab.Name,
        TextColor3 = Config.TextMid,
        TextSize = 12,
        Font = Config.FontMid,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local page = new("ScrollingFrame", {
        Name = "Page_" .. tab.Name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Config.Accent,
        ScrollBarImageTransparency = 0.35,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Content,
    })
    pad(page, 14)
    listLayout(page, 8)

    tab.Button = btn
    tab.Page = page
    tab.Indicator = ind
    tab.Icon = ic
    tab.Label = lbl

    btn.MouseEnter:Connect(function()
        if self.CurrentTab ~= tab then
            safeTween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.55 })
            safeTween(lbl, TweenInfo.new(0.15), { TextColor3 = Config.Text })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.CurrentTab ~= tab then
            safeTween(btn, TweenInfo.new(0.15), { BackgroundTransparency = 1 })
            safeTween(lbl, TweenInfo.new(0.15), { TextColor3 = Config.TextMid })
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

function MaxUI:SelectTab(tab)
    if self.CurrentTab == tab then return end
    for _, t in ipairs(self.Tabs) do
        if t == tab then
            t.Page.Visible = true
            safeTween(t.Button, TweenInfo.new(0.2), { BackgroundTransparency = 0.35, BackgroundColor3 = Config.Panel })
            safeTween(t.Label, TweenInfo.new(0.2), { TextColor3 = Config.Text })
            safeTween(t.Icon, TweenInfo.new(0.2), { TextColor3 = Config.Accent })
            safeTween(t.Indicator, TweenInfo.new(0.25), { Size = UDim2.new(0, 3, 0, 20) })
        else
            t.Page.Visible = false
            safeTween(t.Button, TweenInfo.new(0.2), { BackgroundTransparency = 1 })
            safeTween(t.Label, TweenInfo.new(0.2), { TextColor3 = Config.TextMid })
            safeTween(t.Icon, TweenInfo.new(0.2), { TextColor3 = Config.TextDim })
            safeTween(t.Indicator, TweenInfo.new(0.25), { Size = UDim2.new(0, 3, 0, 0) })
        end
    end
    self.CurrentTab = tab
end

