-- ═══════════════════════════════════════════════════════════════
--  NOTIFICATIONS SYSTEM — فخم مع أنيميشن
-- ═══════════════════════════════════════════════════════════════
function MaxUI:Notify(o)
    o = o or {}
    local title   = o.Title or "إشعار"
    local text    = o.Text or ""
    local dur     = o.Duration or 4
    local ntype   = o.Type or "info"
    local icon    = o.Icon

    local colors = {
        info    = { c = Config.Accent,  ic = "ℹ" },
        success = { c = Config.Success, ic = "✓" },
        warning = { c = Config.Warn,    ic = "⚠" },
        error   = { c = Config.Danger,  ic = "✕" },
        loading = { c = Config.Accent3, ic = "◌" },
    }
    local cfg = colors[ntype] or colors.info
    local accent = cfg.c
    local ic = icon or cfg.ic

    if not self._notifyHolder then
        self._notifyHolder = new("Frame", {
            Name = "NotifyHolder",
            Size = UDim2.new(0, 340, 1, -80),
            Position = UDim2.new(1, -20, 0, 60),
            AnchorPoint = Vector2.new(1, 0),
            BackgroundTransparency = 1,
            ZIndex = 9999,
            Parent = self.Screen,
        })
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, 8),
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            VerticalAlignment = Enum.VerticalAlignment.Top,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = self._notifyHolder,
        })
    end

    local card = new("Frame", {
        Name = "Notify",
        Size = UDim2.new(1, 0, 0, 74),
        Position = UDim2.new(1, 380, 0, 0),
        BackgroundColor3 = Config.BG2,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 10000,
        Parent = self._notifyHolder,
    })
    corner(card, 12)
    stroke(card, accent, 1.4, 0.15)
    grad(card, Config.BG2, Config.BG, 90)

    local sideBar = new("Frame", {
        Size = UDim2.new(0, 4, 1, -8),
        Position = UDim2.new(0, 0, 0, 4),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 10001,
        Parent = card,
    })
    corner(sideBar, 2)
    grad(sideBar, accent, Config.Accent2, 90)

    local iconWrap = new("Frame", {
        Size = UDim2.new(0, 38, 0, 38),
        Position = UDim2.new(0, 14, 0.5, -19),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0,
        ZIndex = 10001,
        Parent = card,
    })
    corner(iconWrap, 19)
    stroke(iconWrap, accent, 1.2, 0.2)

    new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = ic,
        TextColor3 = accent,
        TextSize = 18,
        Font = Config.Font,
        ZIndex = 10002,
        Parent = iconWrap,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 20),
        Position = UDim2.new(0, 62, 0, 12),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 13,
        Font = Config.Font,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10001,
        Parent = card,
    })

    new("TextLabel", {
        Size = UDim2.new(1, -80, 0, 28),
        Position = UDim2.new(0, 62, 0, 32),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Config.TextMid,
        TextSize = 11,
        Font = Config.FontLight,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 10001,
        Parent = card,
    })

    local progressBg = new("Frame", {
        Size = UDim2.new(1, -8, 0, 3),
        Position = UDim2.new(0, 4, 1, -4),
        BackgroundColor3 = Config.BG,
        BorderSizePixel = 0,
        ZIndex = 10001,
        Parent = card,
    })
    corner(progressBg, 2)

    local progressFill = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        ZIndex = 10002,
        Parent = progressBg,
    })
    corner(progressFill, 2)
    grad(progressFill, accent, Config.Accent2, 0)

    if self.AnimEnabled then
        TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0),
        }):Play()
    else
        card.Position = UDim2.new(0, 0, 0, 0)
    end

    TweenService:Create(progressFill, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 1, 0),
    }):Play()

    if self.AnimEnabled and ntype == "loading" then
        TweenService:Create(iconWrap, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
            Rotation = 360,
        }):Play()
    end

    local function close()
        if not card or not card.Parent then return end
        local tween = TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 380, 0, 0),
            BackgroundTransparency = 1,
        })
        tween:Play()
        tween.Completed:Connect(function()
            pcall(function() card:Destroy() end)
        end)
    end

    if ntype ~= "loading" then
        task.delay(dur, close)
    end

    local closeBtn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 10003,
        Parent = card,
    })
    closeBtn.MouseButton1Click:Connect(close)

    return card
end

function MaxUI:NotifySuccess(title, text, dur)
    return self:Notify({ Title = title, Text = text, Type = "success", Duration = dur or 4 })
end
function MaxUI:NotifyError(title, text, dur)
    return self:Notify({ Title = title, Text = text, Type = "error", Duration = dur or 4 })
end
function MaxUI:NotifyWarning(title, text, dur)
    return self:Notify({ Title = title, Text = text, Type = "warning", Duration = dur or 4 })
end
function MaxUI:NotifyInfo(title, text, dur)
    return self:Notify({ Title = title, Text = text, Type = "info", Duration = dur or 4 })
end
function MaxUI:NotifyLoading(title, text)
    return self:Notify({ Title = title, Text = text, Type = "loading", Duration = 999 })
end

