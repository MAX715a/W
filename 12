function MaxUI.new(opts)
    opts = opts or {}
    local self = setmetatable({}, MaxUI)

    self.Opts         = opts
    self.Tabs         = {}
    self.CurrentTab   = nil
    self.Connections  = {}
    self.Minimized    = false
    self.Locked       = false
    self.Flags        = {}
    self.Visible      = true
    
    self.Title        = opts.Title or Config.Name
    self.Subtitle     = opts.Subtitle or "premium edition"
    self.Icon         = opts.Icon or Config.Icon
    self.GuiName      = opts.Name or ("MaxUI_" .. tostring(math.random(10000, 99999)))
    
    self.ShowStatusBar = (opts.StatusBar ~= false)
    self.AnimEnabled   = (opts.Animations ~= false)
    Config.AnimEnabled = self.AnimEnabled

    self:_build()
    return self
end

function MaxUI:_build()
    local parent = getGuiParent()

    self.Screen = new("ScreenGui", {
        Name = self.GuiName,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 9999,
    })
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(self.Screen) end
    end)
    self.Screen.Parent = parent

    self.Overlay = new("Frame", {
        Name = "Overlay",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 0,
        Parent = self.Screen,
    })

    self.Root = new("Frame", {
        Name = "Root",
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Parent = self.Screen,
    })
    self.UIScale = new("UIScale", { Scale = Config.UIScale, Parent = self.Root })

    self.Glow = new("Frame", {
        Name = "Glow",
        Size = UDim2.new(1, 24, 1, 24),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Config.Accent,
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
        ZIndex = 1,
        Parent = self.Root,
    })
    corner(self.Glow, 22)
    grad(self.Glow, Config.Accent, Config.Accent2, 45)

    self.Main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 620, 0, 420),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Config.BG,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        ZIndex = 2,
        Parent = self.Root,
    })
    corner(self.Main, 16)
    stroke(self.Main, Config.Stroke, 1.4, 0.2)
    grad(self.Main, Config.BG, Config.BG2, 135)

    self:_buildHeader()
    self:_buildSidebar()
    self:_buildContent()
    if self.ShowStatusBar then
        self:_buildStatusBar()
    end
    self:_buildPageChrome()
    self:_playEntrance()
end

