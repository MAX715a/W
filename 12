    new("TextLabel", {
        Size = UDim2.new(1, -140, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 13,
        Font = Config.FontMid,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = wrap,
    })

    local selected = new("TextButton", {
        Size = UDim2.new(0, 110, 0, 26),
        Position = UDim2.new(1, -124, 0.5, -13),
        BackgroundColor3 = Config.BG2,
        BorderSizePixel = 0,
        Text = tostring(def) .. "  ▼",
        TextColor3 = Config.Text,
        TextSize = 11,
        Font = Config.FontMid,
        AutoButtonColor = false,
        Parent = wrap,
    })
    corner(selected, 6)
    stroke(selected, Config.Stroke, 1, 0.4)

    local list = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 0, math.min(#options * 30, 160)),
        Position = UDim2.new(0, 8, 0, 46),
        BackgroundColor3 = Config.BG2,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 5,
        Parent = wrap,
    })
    corner(list, 8)
    stroke(list, Config.Stroke, 1, 0.3)
    pad(list, 4)
    listLayout(list, 3)

    local state = { value = def, open = false }
    self.Flags[flag] = def

    local buttons = {}
    for i, opt in ipairs(options) do
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = opt == def and Config.Accent or Config.Panel,
            BackgroundTransparency = opt == def and 0.1 or 0.4,
            BorderSizePixel = 0,
            Text = tostring(opt),
            TextColor3 = opt == def and Color3.fromRGB(255, 255, 255) or Config.TextMid,
            TextSize = 11,
            Font = Config.FontMid,
            AutoButtonColor = false,
            LayoutOrder = i,
            Parent = list,
        })
        corner(btn, 6)

        btn.MouseEnter:Connect(function()
            if opt ~= state.value then
                safeTween(btn, TweenInfo.new(0.15), { BackgroundColor3 = Config.PanelHover, BackgroundTransparency = 0.1 })
            end
        end)
        btn.MouseLeave:Connect(function()
            if opt ~= state.value then
                safeTween(btn, TweenInfo.new(0.15), { BackgroundColor3 = Config.Panel, BackgroundTransparency = 0.4 })
            end
        end)
        btn.MouseButton1Click:Connect(function()
            state.value = opt
            self.Flags[flag] = opt
            selected.Text = tostring(opt) .. "  ▼"
            for _, b in ipairs(buttons) do
                local isSel = b.Text == tostring(opt)
                safeTween(b, TweenInfo.new(0.2), {
                    BackgroundColor3 = isSel and Config.Accent or Config.Panel,
                    BackgroundTransparency = isSel and 0.1 or 0.4,
                    TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or Config.TextMid,
                })
            end
            state.open = false
            list.Visible = false
            safeTween(wrap, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = UDim2.new(1, 0, 0, 42) })
            if cb then task.spawn(cb, opt) end
        end)
        table.insert(buttons, btn)
    end

    selected.MouseButton1Click:Connect(function()
        state.open = not state.open
        list.Visible = state.open
        selected.Text = tostring(state.value) .. (state.open and "  ▲" or "  ▼")
        local targetH = state.open and (42 + math.min(#options * 30, 160) + 8) or 42
        safeTween(wrap, TweenInfo.new(0.25, Enum.EasingStyle.Quint), { Size = UDim2.new(1, 0, 0, targetH) })
    end)

    return {
        Set = function(_, v)
            state.value = v
            selected.Text = tostring(v) .. "  ▼"
        end,
        Get = function() return state.value end,
    }
end

