        }, Row)

        local Label = create("TextLabel", {
            Size = UDim2.new(0.6, 0, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = Text or "Keybind",
            TextColor3 = Color3.fromRGB(220, 225, 235),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1,
        }, Row)

        local KeyBtn = create("TextButton", {
            Size = UDim2.new(0, 90, 0, 26),
            Position = UDim2.new(1, -102, 0.5, -13),
            BackgroundColor3 = Color3.fromRGB(20, 22, 30),
            BackgroundTransparency = 1,
            Text = Default and Default.Name or "اضغط",
            TextColor3 = Default and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(130, 135, 150),
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            AutoButtonColor = false,
            TextTransparency = 1,
        }, Row)
        create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = KeyBtn })
        local KeyStroke = create("UIStroke", {
            Color = Color3.fromRGB(60, 65, 80),
            Thickness = 1.2,
            Transparency = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, KeyBtn)

        task.spawn(function()
            task.wait(0.6)
            anim(Row, { BackgroundTransparency = 0 }, 0.3)
            anim(RowStroke, { Transparency = 0 }, 0.3)
            anim(Label, { TextTransparency = 0 }, 0.3)
            anim(KeyBtn, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.3)
            anim(KeyStroke, { Transparency = 0 }, 0.3)
        end)

        KeyBtn.MouseButton1Click:Connect(function()
            State.Listening = true
            KeyBtn.Text = "انتظر..."
            anim(KeyBtn, { TextColor3 = Color3.fromRGB(240, 180, 60) }, 0.15)
        end)

        table.insert(self._connections, UserInputService.InputBegan:Connect(function(input, gp)
            if State.Listening then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode == Enum.KeyCode.Backspace then
                        State.Key = nil
                        KeyBtn.Text = "لا شيء"
                        KeyBtn.TextColor3 = Color3.fromRGB(130, 135, 150)
                        self.Flags[Flag] = nil
                    else
                        State.Key = input.KeyCode
                        KeyBtn.Text = input.KeyCode.Name
                        KeyBtn.TextColor3 = Color3.fromRGB(80, 200, 120)
                        self.Flags[Flag] = input.KeyCode
                    end
                    State.Listening = false
                end
            elseif not gp and State.Key and input.KeyCode == State.Key then
                if OnPress then task.spawn(OnPress) end
            end
        end))

        return {
            Set = function(_, k)
                State.Key = k
                KeyBtn.Text = k and k.Name or "لا شيء"
                KeyBtn.TextColor3 = k and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(130, 135, 150)
            end,
            Get = function() return State.Key end,
        }
    end

