    row.MouseLeave:Connect(function()
        if not state.value then
            safeTween(row, TweenInfo.new(0.15), { BackgroundTransparency = 0.35 })
        end
    end)

    setValue(def, false)

    return {
        Set = function(_, v) setValue(v, true) end,
        Get = function() return state.value end,
        Row = row,
    }
end

