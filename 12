local MaxUI = loadstring(game:HttpGet("رابط_الملف_على_جيتهاب"))()

local Window = MaxUI.CreateWindow("MAX", "صنع بواسطة MAX")

-- إشعار ترحيبي (بعد ما الأنيميشن يخلص)
task.delay(1.2, function()
    Window:NotifySuccess("مرحباً", "MAX UI اشتغل بنجاح!")
end)

-- قسم
Window:AddSection("  الخيارات الأساسية  ")

-- زر
Window:AddButton("زر تجريبي", function()
    Window:NotifyInfo("تم", "ضغطت على الزر")
end)

-- Toggle
Window:AddToggle("تفعيل الميزة", false, function(v)
    print("Toggle:", v)
end, "feature1")

-- Slider
Window:AddSlider("السرعة", 70, 400, 300, function(v)
    print("Speed:", v)
end, "speed")

-- Input
Window:AddInput("اكتب هنا...", "تطبيق", function(text)
    print("Input:", text)
end)

-- Dropdown
Window:AddDropdown("اختر خيار", {"خيار 1", "خيار 2", "خيار 3"}, "خيار 1", function(v)
    print("Selected:", v)
end, "dropdown1")

-- Grid Buttons
Window:AddGridButtons({"A", "B", "C", "D", "E"}, function(v)
    print("Grid:", v)
end)

-- Label
Window:AddLabel("هذا نص توضيحي")
