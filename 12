                    state.key = input.KeyCode
                    btn.Text = input.KeyCode.Name
                    btn.TextColor3 = Config.Accent
                    self.Flags[flag] = input.KeyCode
                end
                state.listening = false
                safeTween(bs, TweenInfo.new(0.15), { Color = Config.Stroke, Transparency = 0.4 })
            end
        elseif not gp and state.key and input.KeyCode == state.key then
            if cb then task.spawn(cb) end
        end
    end))

    return {
        Set = function(_, k)
            state.key = k
            btn.Text = k and k.Name or "لا شيء"
        end,
        Get = function() return state.key end,
    }
end

