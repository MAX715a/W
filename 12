    -- ═══════════════════════════════════════════════════════════
    --  ELEMENT: AddGridButtons
    -- ═══════════════════════════════════════════════════════════
    function Window:AddGridButtons(ButtonsTable, OnClick)
        local GridContainer = create("Frame", {
            Size = UDim2.new(1, 0, 0, 100),
            BackgroundTransparency = 1,
        }, self._elementsContainer)

        create("UIGridLayout", {
            CellSize = UDim2.new(0.31, 0, 0.42, 0),
            CellPadding = UDim2.new(0.03, 0, 0.12, 0),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, GridContainer)

        local i = 0
        for _, Value in ipairs(ButtonsTable) do
            i = i + 1
            local PresetBtn = create("TextButton", {
                Text = tostring(Value),
                BackgroundColor3 = Color3.fromRGB(24, 26, 34),
                TextColor3 = Color3.fromRGB(180, 185, 200),
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                AutoButtonColor = false,
                BackgroundTransparency = 1,
                TextTransparency = 1,
            }, GridContainer)
            create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = PresetBtn })
            local BtnStroke = create("UIStroke", {
                Color = Color3.fromRGB(60, 65, 80),
                Thickness = 1.2,
                Transparency = 1,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            }, PresetBtn)

            task.spawn(function()
                task.wait(0.55 + (i - 1) * 0.06)
                anim(PresetBtn, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.28)
                anim(BtnStroke, { Transparency = 0 }, 0.28)
            end)

            PresetBtn.MouseEnter:Connect(function()
                anim(PresetBtn, { BackgroundColor3 = Color3.fromRGB(35, 40, 52) }, 0.12)
                anim(BtnStroke, { Color = Color3.fromRGB(120, 130, 160) }, 0.12)
            end)
            PresetBtn.MouseLeave:Connect(function()
                anim(PresetBtn, { BackgroundColor3 = Color3.fromRGB(24, 26, 34) }, 0.12)
                anim(BtnStroke, { Color = Color3.fromRGB(60, 65, 80) }, 0.12)
            end)
            PresetBtn.MouseButton1Click:Connect(function()
                if OnClick then task.spawn(OnClick, Value) end
            end)
        end

        return GridContainer
    end

