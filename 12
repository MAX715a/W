    function Window:Notify(Options)
        Options = Options or {}
        local title = Options.Title or "إشعار"
        local text = Options.Text or ""
        local dur = Options.Duration or 4
        local ntype = Options.Type or "info"

        local colors = {
            info    = Color3.fromRGB(60, 140, 240),
            success = Color3.fromRGB(80, 200, 120),
            warning = Color3.fromRGB(240, 180, 60),
            error   = Color3.fromRGB(220, 70, 80),
        }
        local icons = {
            info    = "ℹ",
            success = "✓",
            warning = "⚠",
            error   = "✕",
        }
        local accent = colors[ntype] or colors.info
        local icon = icons[ntype] or "ℹ"

        local Card = create("Frame", {
            Size = UDim2.new(1, 0, 0, 66),
            Position = UDim2.new(1, 350, 0, 0),
            BackgroundColor3 = Color3.fromRGB(20, 22, 30),
            BorderSizePixel = 0,
            ClipsDescendants = true,
            ZIndex = 10000,
        }, self._notifyHolder)
        create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = Card })
        local cs = create("UIStroke", {
            Color = accent,
            Thickness = 1.3,
            Transparency = 0.2,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, Card)

        local Bar = create("Frame", {
            Size = UDim2.new(0, 3, 1, -8),
            Position = UDim2.new(0, 0, 0, 4),
            BackgroundColor3 = accent,
            BorderSizePixel = 0,
        }, Card)
        create("UICorner", { CornerRadius = UDim.new(0, 2), Parent = Bar })

        local Ico = create("TextLabel", {
            Size = UDim2.new(0, 32, 0, 32),
            Position = UDim2.new(0, 12, 0.5, -16),
            BackgroundColor3 = accent,
            BackgroundTransparency = 0.85,
            Text = icon,
            TextColor3 = accent,
            Font = Enum.Font.GothamBold,
            TextSize = 16,
        }, Card)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Ico })

        create("TextLabel", {
            Size = UDim2.new(1, -60, 0, 18),
            Position = UDim2.new(0, 54, 0, 10),
            BackgroundTransparency = 1,
            Text = title,
            TextColor3 = Color3.fromRGB(240, 242, 245),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, Card)

        create("TextLabel", {
            Size = UDim2.new(1, -60, 0, 26),
            Position = UDim2.new(0, 54, 0, 30),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Color3.fromRGB(160, 165, 180),
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top,
        }, Card)

        anim(Card, { Position = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        task.delay(dur, function()
            if Card and Card.Parent then
                local out = anim(Card, {
                    Position = UDim2.new(1, 350, 0, 0),
                    BackgroundTransparency = 1,
                }, 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                if out then
                    out.Completed:Connect(function()
                        pcall(function() Card:Destroy() end)
                    end)
                end
            end
        end)

        return Card
    end

    function Window:NotifySuccess(t, x, d) return self:Notify({ Title = t, Text = x, Type = "success", Duration = d }) end
    function Window:NotifyError(t, x, d)   return self:Notify({ Title = t, Text = x, Type = "error",   Duration = d }) end
    function Window:NotifyWarning(t, x, d) return self:Notify({ Title = t, Text = x, Type = "warning", Duration = d }) end
    function Window:NotifyInfo(t, x, d)    return self:Notify({ Title = t, Text = x, Type = "info",    Duration = d }) end
