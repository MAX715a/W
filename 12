        local Label = create("TextLabel", {
            Size = UDim2.new(0.7, 0, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = Text or "Toggle",
            TextColor3 = Color3.fromRGB(220, 225, 235),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1,
        }, ToggleFrame)

        local Track = create("TextButton", {
            Size = UDim2.new(0, 44, 0, 24),
            Position = UDim2.new(1, -54, 0.5, -12),
            BackgroundColor3 = State.Value and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(40, 44, 55),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
        }, ToggleFrame)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })

        local TrackStroke = create("UIStroke", {
            Color = State.Value and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(60, 65, 80),
            Thickness = 1.2,
            Transparency = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, Track)

        local Knob = create("Frame", {
            Size = UDim2.new(0, 18, 0, 18),
            Position = State.Value and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
            BackgroundColor3 = Color3.fromRGB(240, 242, 245),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
        }, Track)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })

        task.spawn(function()
            task.wait(0.6)
            anim(ToggleFrame, { BackgroundTransparency = 0 }, 0.3)
            anim(FrameStroke, { Transparency = 0 }, 0.3)
            anim(Label, { TextTransparency = 0 }, 0.3)
            anim(Track, { BackgroundTransparency = 0 }, 0.3)
            anim(TrackStroke, { Transparency = 0 }, 0.3)
            anim(Knob, { BackgroundTransparency = 0 }, 0.3)
        end)

        local function SetValue(val, fire)
            State.Value = val
            self.Flags[Flag] = val
            local onColor = Color3.fromRGB(80, 200, 120)
            local offColor = Color3.fromRGB(40, 44, 55)
            anim(Track, { BackgroundColor3 = val and onColor or offColor }, 0.2)
            anim(TrackStroke, { Color = val and onColor or Color3.fromRGB(60, 65, 80) }, 0.2)
            anim(Knob, {
                Position = val and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
            }, 0.22)
            if fire and OnChange then task.spawn(OnChange, val) end
        end

        Track.MouseButton1Click:Connect(function()
            SetValue(not State.Value, true)
        end)

        SetValue(Default or false, false)

        return {
            Set = function(_, v) SetValue(v, true) end,
            Get = function() return State.Value end,
            Toggle = ToggleFrame,
        }
    end

    -- ═══════════════════════════════════════════════════════════
    --  ELEMENT: AddSlider
    -- ═══════════════════════════════════════════════════════════
    function Window:AddSlider(Text, Min, Max, Default, OnChange, Flag, Suffix)
        Flag = Flag or Text
        Min = Min or 0
        Max = Max or 100
        Default = Default or Min
        Suffix = Suffix or ""
        local State = { Value = Default }

        local SliderFrame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 56),
            BackgroundColor3 = Color3.fromRGB(24, 26, 34),
            BackgroundTransparency = 1,
        }, self._elementsContainer)
        create("UICorner", { CornerRadius = UDim.new(0, 10), Parent = SliderFrame })
        local FrameStroke = create("UIStroke", {
            Color = Color3.fromRGB(60, 65, 80),
            Thickness = 1.2,
            Transparency = 1,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, SliderFrame)

        local Label = create("TextLabel", {
            Size = UDim2.new(0.6, 0, 0, 20),
            Position = UDim2.new(0, 12, 0, 6),
            BackgroundTransparency = 1,
            Text = Text or "Slider",
            TextColor3 = Color3.fromRGB(220, 225, 235),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1,
        }, SliderFrame)

        local ValueLbl = create("TextLabel", {
            Size = UDim2.new(0.3, 0, 0, 20),
            Position = UDim2.new(0.7, 0, 0, 6),
            BackgroundTransparency = 1,
            Text = tostring(Default) .. Suffix,
            TextColor3 = Color3.fromRGB(80, 200, 120),
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTransparency = 1,
        }, SliderFrame)

        local Track = create("Frame", {
            Size = UDim2.new(1, -24, 0, 8),
            Position = UDim2.new(0, 12, 0, 34),
            BackgroundColor3 = Color3.fromRGB(30, 34, 44),
            BackgroundTransparency = 1,
        }, SliderFrame)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })

        local Fill = create("Frame", {
            Size = UDim2.new((Default - Min) / math.max(Max - Min, 0.001), 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(80, 200, 120),
            BackgroundTransparency = 1,
        }, Track)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Fill })

        local Knob = create("Frame", {
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new((Default - Min) / math.max(Max - Min, 0.001), -8, 0.5, -8),
            BackgroundColor3 = Color3.fromRGB(240, 242, 245),
            BackgroundTransparency = 1,
        }, Track)
        create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })

        task.spawn(function()
            task.wait(0.6)
            anim(SliderFrame, { BackgroundTransparency = 0 }, 0.3)
            anim(FrameStroke, { Transparency = 0 }, 0.3)
            anim(Label, { TextTransparency = 0 }, 0.3)
            anim(ValueLbl, { TextTransparency = 0 }, 0.3)
            anim(Track, { BackgroundTransparency = 0 }, 0.3)
            anim(Fill, { BackgroundTransparency = 0 }, 0.3)
            anim(Knob, { BackgroundTransparency = 0 }, 0.3)
        end)

        local dragging = false
        local function updateFromX(x)
            local rel = math.clamp((x - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1)
            local v = math.floor(Min + (Max - Min) * rel + 0.5)
            State.Value = v
            self.Flags[Flag] = v
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            Knob.Position = UDim2.new(rel, -8, 0.5, -8)
            ValueLbl.Text = tostring(v) .. Suffix
            if OnChange then task.spawn(OnChange, v) end
        end

        Track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateFromX(i.Position.X)
            end
        end)
        Knob.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
            end
        end)
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(i)
            if not dragging then return end
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                updateFromX(i.Position.X)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))

        return {
            Set = function(_, v)
                v = math.clamp(v, Min, Max)
                State.Value = v
                self.Flags[Flag] = v
                local rel = (v - Min) / math.max(Max - Min, 0.001)
                Fill.Size = UDim2.new(rel, 0, 1, 0)
                Knob.Position = UDim2.new(rel, -8, 0.5, -8)
                ValueLbl.Text = tostring(v) .. Suffix
            end,
            Get = function() return State.Value end,
        }
    end

