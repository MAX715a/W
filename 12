        Name = "MAX_CustomUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(MaxScreenGui) end
    end)
    safeParent(MaxScreenGui)
    Window.ScreenGui = MaxScreenGui

    -- ──────────────────────────────────────────────────────────
    --  OVERLAY (خلفية معتمة تظهر عند الفتح)
