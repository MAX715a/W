-- ═══════════════════════════════════════════════════════════════
function MaxUI:AddSlider(tab, o)
    o = o or {}
    local title = o.Title or "Slider"
    local min   = o.Min or 0
    local max   = o.Max or 100
    local def   = o.Default or min
    local suffix = o.Suffix or ""
    local flag  = o.Flag or title
    local cb    = o.Callback
    local decimals = o.Decimals or 0

    local wrap = new("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = Config.Panel,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Parent = tab.Page,
    })
    corner(wrap, 10)
    stroke(wrap, Config.Stroke, 1, 0.5)

    new("TextLabel", {
        Size = UDim2.new(1, -100, 0, 18),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Config.Text,
        TextSize = 13,
        Font = Config.FontMid,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = wrap,
    })

    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 80, 0, 18),
        Position = UDim2.new(1, -94, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(def) .. suffix,
        TextColor3 = Config.Accent,
        TextSize = 13,
        Font = Config.Font,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = wrap,
    })

    local track = new("Frame", {
        Size = UDim2.new(1, -28, 0, 8),
        Position = UDim2.new(0, 14, 0, 38),
        BackgroundColor3 = Config.BG2,
        BorderSizePixel = 0,
        Parent = wrap,
    })
    corner(track, 4)

    local fill = new("Frame", {
        Size = UDim2.new((def - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 4)
    grad(fill, Config.Accent, Config.Accent2, 0)

    local knob = new("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new((def - min) / (max - min), -8, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = track,
    })
    corner(knob, 8)
    stroke(knob, Config.Accent, 2, 0)

    local dragging = false
    local state = { value = def }

    local function round(n)
        local m = 10 ^ decimals
        return math.floor(n * m + 0.5) / m
    end

    local function updateFromX(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = round(min + (max - min) * rel)
        state.value = v
        self.Flags[flag] = v
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -8, 0.5, -8)
        valLbl.Text = tostring(v) .. suffix
        if cb then task.spawn(cb, v) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            updateFromX(input.Position.X)
        end
    end))
    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return {
        Set = function(_, v)
            v = math.clamp(v, min, max)
            state.value = v
            local rel = (v - min) / (max - min)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -8, 0.5, -8)
            valLbl.Text = tostring(v) .. suffix
        end,
        Get = function() return state.value end,
    }
end

