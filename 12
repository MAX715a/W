function MaxUI:_buildPageChrome()
    self.Particles = {}
    if not self.AnimEnabled then return end
    for i = 1, 6 do
        local dot = new("Frame", {
            Size = UDim2.new(0, 2, 0, 2),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = i % 2 == 0 and Config.Accent or Config.Accent2,
            BackgroundTransparency = 0.75,
            BorderSizePixel = 0,
            ZIndex = 3,
            Parent = self.Content,
        })
        corner(dot, 1)
        table.insert(self.Particles, {
            inst = dot,
            spd = 0.05 + math.random() * 0.05,
            off = math.random() * math.pi * 2,
        })
    end

    table.insert(self.Connections, RunService.Heartbeat:Connect(function()
        if not self.AnimEnabled then return end
        local t = tick()
        for _, p in ipairs(self.Particles) do
            if p.inst and p.inst.Parent then
                local x = (math.sin(t * p.spd + p.off) + 1) / 2
                local y = (math.cos(t * p.spd * 0.8 + p.off) + 1) / 2
                p.inst.Position = UDim2.new(x, 0, y, 0)
            end
        end
    end))
end

-- ═══════════════════════════════════════════════════════════════
--  ANIMATIONS
-- ═══════════════════════════════════════════════════════════════
function MaxUI:_playEntrance()
    if not self.AnimEnabled then return end
    self.Main.Size = UDim2.new(0, 0, 0, 420)
    self.Main.BackgroundTransparency = 1

    task.spawn(function()
        task.wait(0.04)
        safeTween(self.Main, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 620, 0, 420),
        })
        safeTween(self.Main, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0,
        })
        safeTween(self.Glow, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
            BackgroundTransparency = 0.72,
        })
    end)
end

function MaxUI:_playExit(cb)
    if not self.AnimEnabled then cb() return end
    safeTween(self.Main, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 420),
        BackgroundTransparency = 1,
    })
    task.delay(0.26, cb)
end

-- ═══════════════════════════════════════════════════════════════
--  DRAG
-- ═══════════════════════════════════════════════════════════════
function MaxUI:_makeDraggable(zone, target)
    local dragging, dragStart, startPos = false, nil, nil

    zone.InputBegan:Connect(function(input)
        if self.Locked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
        end
    end)

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = input.Position - dragStart
        target.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end))

    table.insert(self.Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

-- ═══════════════════════════════════════════════════════════════
--  CONTROLS
-- ═══════════════════════════════════════════════════════════════
function MaxUI:ToggleLock()
    self.Locked = not self.Locked
    if self.BtnLock then
        safeTween(self.BtnLock, TweenInfo.new(0.2), {
            TextColor3 = self.Locked and Config.Danger or Config.TextMid,
        })
        self.BtnLock.Text = self.Locked and "🔓" or "🔒"
    end
end

function MaxUI:ToggleMin()
    self.Minimized = not self.Minimized
    local h = self.Minimized and 52 or 420
    safeTween(self.Main, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 620, 0, h),
    })
    if self.BtnMin then
        self.BtnMin.Text = self.Minimized and "▢" or "—"
    end
end

function MaxUI:ToggleVisibility()
    self.Visible = not self.Visible
    self.Screen.Enabled = self.Visible
end

function MaxUI:SetAnimations(enabled)
    self.AnimEnabled = enabled
    Config.AnimEnabled = enabled
    for _, p in ipairs(self.Particles) do
        if p.inst then p.inst.Visible = enabled end
    end
end

function MaxUI:Destroy()
    self:_playExit(function()
        for _, c in ipairs(self.Connections) do
            pcall(function() c:Disconnect() end)
        end
        pcall(function() self.Screen:Destroy() end)
    end)
end

function MaxUI:BindToggle(key)
    table.insert(self.Connections, UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == key then
            self:ToggleVisibility()
        end
    end))
end

